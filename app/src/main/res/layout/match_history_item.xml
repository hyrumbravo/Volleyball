<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/itemContainer"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dark_gray_outline"
    android:layout_marginBottom="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingVertical="10dp">

        <!--        set score1-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/teamSetScoreContainer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/homeText"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="Home"
                style="@style/match_history_team_name_style" />

            <TextView
                android:id="@+id/homeScore"
                android:text="0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/homeText"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/match_history_score_style" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/dash"
            app:layout_constraintTop_toTopOf="@id/teamSetScoreContainer1"
            app:layout_constraintStart_toEndOf="@id/teamSetScoreContainer1"
            app:layout_constraintBottom_toBottomOf="@id/teamSetScoreContainer1"
            android:textColor="@color/dark_gray"
            android:text="-"
            android:layout_marginStart="10dp"
            style="@style/match_history_team_name_style"/>

        <!--        set score 2-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/teamSetScoreContainer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/dash"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/guestScore"
                android:text="0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/match_history_score_style"
                android:background="@drawable/square_yellow"
                android:layout_marginStart="0dp"/>

            <TextView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/guestScore"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="Guest"
                android:textColor="@color/team2_yellow"
                style="@style/match_history_team_name_style"
                android:layout_marginStart="10dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>