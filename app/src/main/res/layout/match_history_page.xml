<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MatchHistoryPage"
    android:background="@color/white">
<!--    game details overlay-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameDetailsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_color"
        android:elevation="1dp"
        android:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settingsPopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/soft_squre_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="20dp"
            android:paddingVertical="15dp"
            android:paddingStart="15dp">

            <TextView
                android:id="@+id/settingsTitle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="Game Details"
                android:textSize="18sp"
                android:textColor="@color/dark_gray"
                style="@style/form_team_name_style"/>

            <View
                android:id="@+id/gameDetailsTitleDivider"
                app:layout_constraintTop_toBottomOf="@id/settingsTitle"
                style="@style/game_details_divider" />

<!--            home set scores-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeSetScoreRecyclerview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                app:layout_constraintTop_toBottomOf="@id/gameDetailsTitleDivider"
                app:layout_constraintStart_toEndOf="@id/homeSetScoreLabel"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="20dp"
                android:layout_marginTop="15dp"/>

            <TextView
                android:id="@+id/homeSetScoreLabel"
                app:layout_constraintBottom_toBottomOf="@+id/homeSetScoreRecyclerview"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Home"
                android:textSize="19sp"
                style="@style/form_team_name_style"/>

            <View
                android:id="@+id/setScoreDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/gray"
                app:layout_constraintStart_toStartOf="@id/homeSetScoreLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeSetScoreRecyclerview"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"/>
<!--            guest set scores-->

            <TextView
                android:id="@+id/guestSetScoreLabel"
                app:layout_constraintTop_toTopOf="@id/guestSetScoreRecyclerview"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Guest"
                android:textSize="19sp"
                android:textColor="@color/team2_yellow"
                style="@style/form_team_name_style"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/guestSetScoreRecyclerview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                app:layout_constraintTop_toBottomOf="@id/setScoreDivider"
                app:layout_constraintStart_toEndOf="@id/homeSetScoreLabel"
                android:paddingStart="2.3dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"/>

            <!--    statistics-->
            <TextView
                android:id="@+id/statsTitle"
                app:layout_constraintTop_toBottomOf="@id/guestSetScoreRecyclerview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="Statistics"
                android:textSize="18sp"
                android:textColor="@color/dark_gray"
                style="@style/form_team_name_style"/>

            <View
                android:id="@+id/statsDivider"
                app:layout_constraintTop_toBottomOf="@id/statsTitle"
                style="@style/game_details_divider" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:id="@+id/backButton"
        android:layout_width="35dp"
        android:layout_height="30dp"
        android:src="@drawable/back_button_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"/>

    <TextView
        android:id="@+id/pageTitle"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="PREVIOUS MATCHES"
        style="@style/form_team_name_style"
        android:letterSpacing="0.03"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"/>
    
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/pageTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="15dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/matchHistoryRecyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="15dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>