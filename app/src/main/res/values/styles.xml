<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="timer_text_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textColor">@color/violet</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="timeout_icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
    </style>

    <style name="timeout_count_style">
        <item name="android:layout_width">17dp</item>
        <item name="android:layout_height">17dp</item>
        <item name="android:background">@drawable/violet_circle</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginBottom">-5dp</item>
    </style>

    <style name="team_name_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textColor">@color/team1_violet</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="set_score_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/square_violet</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textSize">33sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>

    <style name="score_style">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/square_violet</item>
        <item name="android:textSize">90sp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:paddingVertical">20dp</item>
    </style>

    <style name="stat_button_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">70dp</item>
        <item name="android:background">@drawable/square_gray</item>
        <item name="android:textColor">@color/violet</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="playerTableHeaderText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="form_team_name_style" parent="team_name_style">
        <item name="android:textSize">20sp</item>
        <item name="android:layout_marginStart">2dp</item>
    </style>

    <style name="jersery_num_header" parent="playerTableHeaderText">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_width">80dp</item>
    </style>

    <style name="jerseynum_field">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:maxLength">2</item>
        <item name="android:inputType">number</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>

    <style name="player_name_field">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLength">11</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:inputType">textPersonName</item>
    </style>

    <style name="setting_label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="setting_input">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/gray_outline</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLength">2</item>
        <item name="android:inputType">number</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="match_history_team_name_style">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/team1_violet</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="match_history_score_style">
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:minWidth">30dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/square_violet</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="match_history_set_label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">45dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/timer_bg</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="match_history_set_score">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/square_gray</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingVertical">5dp</item>
    </style>

    <style name="game_details_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/gray</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>