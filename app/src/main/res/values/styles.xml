<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="timer_text_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textColor">@color/violet</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="timeout_icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
    </style>

    <style name="timeout_count_style">
        <item name="android:layout_width">17dp</item>
        <item name="android:layout_height">17dp</item>
        <item name="android:background">@drawable/violet_circle</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginBottom">-5dp</item>
    </style>

    <style name="team_name_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textColor">@color/team1_violet</item>
    </style>

    <style name="set_score_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/square_violet</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:textSize">33sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>

    <style name="score_style">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/square_violet</item>
        <item name="android:textSize">90sp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/digital</item>
        <item name="android:paddingVertical">20dp</item>
    </style>

    <style name="stat_button_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">70dp</item>
        <item name="android:background">@drawable/square_gray</item>
        <item name="android:textColor">@color/violet</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>